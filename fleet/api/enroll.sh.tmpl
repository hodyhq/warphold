#!/bin/sh
# WarpHold agent installer. Generated by the Fleet server at {{.Server}}.
set -eu
# The token is never baked into the served script; supply it at run time. Via
# the environment, so it stays out of every process listing on the box:
#   WARPHOLD_ENROLL_TOKEN=<token> sh -c "$(curl -fsSL https://<fleet>/enroll.sh)"
# or, still supported, as an argument - which is visible in "ps" for as long
# as the script runs and is kept in shell history:
#   curl -fsSL https://<fleet>/enroll.sh | sh -s -- --token <token>
TOKEN="${WARPHOLD_ENROLL_TOKEN:-}"
SERVER="{{.Server}}"
SCOPE="${WARPHOLD_SCOPE:-user}"
while [ $# -gt 0 ]; do
  case "$1" in
    --token) TOKEN="$2"; shift 2 ;;
    --token=*) TOKEN="${1#--token=}"; shift ;;
    --scope) SCOPE="$2"; shift 2 ;;
    *) echo "unknown argument $1" >&2; exit 2 ;;
  esac
done
[ -n "$TOKEN" ] || { echo "usage: WARPHOLD_ENROLL_TOKEN=<token> sh -c \"\$(curl -fsSL {{.Server}}/enroll.sh)\", or sh -s -- --token <token>" >&2; exit 2; }
ARCH="$(uname -m)"; case "$ARCH" in x86_64) ARCH=amd64 ;; aarch64|arm64) ARCH=arm64 ;; *) echo "unsupported arch $ARCH" >&2; exit 1 ;; esac
if [ "$SCOPE" = "system" ]; then BIN=/usr/local/bin; else BIN="${HOME}/.local/bin"; fi
mkdir -p "$BIN"
# The /dl/ route arrives in Plan 2. Until then a binary the operator placed at
# $BIN/warphold is used as-is, and anything else fails loudly rather than
# enrolling with whatever happens to be on the box.
if [ -x "$BIN/warphold" ]; then
  echo "using existing $BIN/warphold"
else
  echo "Downloading warphold ({{.Version}}, linux/$ARCH)..."
  curl -fsSL "{{.Server}}/dl/warphold-linux-$ARCH" -o "$BIN/warphold.tmp" || {
    rm -f "$BIN/warphold.tmp"
    echo "download failed: place the warphold binary at $BIN/warphold and re-run" >&2
    exit 1
  }
  chmod +x "$BIN/warphold.tmp"
  mv "$BIN/warphold.tmp" "$BIN/warphold"
fi
# The token goes to the child through its environment, never its argv, so it
# does not show up in "ps" while the (potentially slow) enroll runs.
echo "Running: warphold agent enroll --server $SERVER --scope $SCOPE (token supplied)"
WARPHOLD_ENROLL_TOKEN="$TOKEN" "$BIN/warphold" agent enroll --server "$SERVER" --scope "$SCOPE"
"$BIN/warphold" agent install --scope "$SCOPE"
echo "Enrolled. The agent is running and will report to $SERVER."
